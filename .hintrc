{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-text-size-adjust",
          "print-color-adjust",
          "print-color-adjust: exact",
          "user-select",
          "background-color: color-mix(in srgb, oklch(21% 0.034 264.665) 50%, transparent)",
          "background-color: color-mix(in srgb, #fff 50%, transparent)"
        ]
      }
    ],
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off",
        "link-name": "off"
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "img[fetchpriority]"
        ]
      }
    ],
    "axe/aria": [
      "default",
      {
        "aria-required-parent": "off"
      }
    ]
  }
}